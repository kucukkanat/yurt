{
  "id": "/myapp/",
  "name": "My App",
  "short_name": "MyApp",
  "description": "One or two sentences about the app. Chromium shows it in the install dialog.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#161614",
  "theme_color": "#161614",
  "categories": ["productivity"],
  "icons": [
    { "src": "pwa-64x64.png", "sizes": "64x64", "type": "image/png", "purpose": "any" },
    { "src": "pwa-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "pwa-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "maskable-icon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "monochrome-icon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ],
  "screenshots": [
    {
      "src": "screenshots/phone-home.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The home screen on a phone"
    },
    {
      "src": "screenshots/desktop-home.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The home screen in a desktop window"
    }
  ],
  "shortcuts": [
    {
      "name": "New item",
      "short_name": "New",
      "url": "./?action=new",
      "icons": [{ "src": "shortcut-new-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    { "name": "Search", "url": "./?action=search" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "handle_links": "preferred",
  "protocol_handlers": [{ "protocol": "web+myapp", "url": "./?link=%s" }],
  "file_handlers": [
    {
      "action": "./?open-file",
      "accept": { "text/markdown": [".md", ".markdown"] }
    }
  ]
}

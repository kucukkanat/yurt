{
  "name": "yurt",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/ui",
    "apps/web",
    "packages/bridge"
  ],
  "scripts": {
    "dev": "bun run --filter @yurt/web dev",
    "build": "bun run --filter @yurt/web build",
    "bridge": "bun run --filter yurt-bridge dev",
    "bridge:build": "bun run --filter yurt-bridge build",
    "test": "bun run --filter @yurt/protocol test && bun run --filter yurt-bridge test && bun run --filter @yurt/web test",
    "e2e": "playwright test",
    "typecheck": "bun run --filter '*' typecheck && tsc -p e2e",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "deadcode": "knip",
    "dupes": "jscpd .",
    "quality": "bun run typecheck && bun run deadcode && bun run dupes && biome ci --error-on-warnings ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22",
    "html-validate": "11.16.1",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "name": "yurt-bridge",
  "license": "MIT",
  "version": "0.3.0",
  "description": "Connects Yurt workspaces to agent CLIs on your machine over ACP. One command, config in the browser.",
  "keywords": [
    "yurt",
    "acp",
    "agent-client-protocol",
    "agents",
    "nostr",
    "cli"
  ],
  "homepage": "https://kucukkanat.github.io/yurt/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kucukkanat/yurt.git",
    "directory": "packages/bridge"
  },
  "type": "module",
  "bin": {
    "yurt-bridge": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --config ui/vite.config.ts && tsx src/cli.ts",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts && tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "valibot": "1.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@yurt/protocol": "*",
    "@yurt/ui": "*",
    "fast-check": "4.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  }
}
